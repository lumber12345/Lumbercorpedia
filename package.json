{
  "name": "lumbercorpedia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lumbercorpedia — a faster, sharper knowledge base and toolkit for Torn City.",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "vite build --ssr tools/ssr-smoke.tsx --outDir dist-smoke --logLevel warn && node tools/run-smoke.mjs"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
